import tkinter as tk
from tkinter import messagebox
import json
import threading
import queue

class GameLogic:
    def __init__(self, size=15):
        self.size = size
        self.board = [['.' for _ in range(size)] for _ in range(size)]
        self.current_player = 'X'
        self.history = []

    def place_stone(self, row, col):
        if self.is_valid_move(row, col):
            self.board[row][col] = self.current_player
            self.history.append((row, col))
            return True
        return False

    def is_valid_move(self, row, col):
        return 0 <= row < self.size and 0 <= col < self.size and self.board[row][col] == '.'

    def switch_player(self):
        self.current_player = 'O' if self.current_player == 'X' else 'X'

    def check_winner(self, row, col):
        directions = [(0, 1), (1, 0), (1, 1), (1, -1)]
        for dr, dc in directions:
            count = self.count_stones(row, col, dr, dc) + self.count_stones(row, col, -dr, -dc) - 1
            if count >= 5:
                return self.current_player
        return None

    def count_stones(self, row, col, dr, dc):
        count = 0
        while 0 <= row < self.size and 0 <= col < self.size and self.board[row][col] == self.current_player:
            row, col = row + dr, col + dc
            count += 1
        return count

    def is_draw(self):
        return all(cell != '.' for row in self.board for cell in row)

class GameState:
    def handle(self, game):
        pass

class PlayingState(GameState):
    def handle(self, game):
        game.draw_board()
        winner = game.game_logic.check_winner(*game.game_logic.history[-1]) if game.game_logic.history else None
        if winner or game.game_logic.is_draw():
            game.state = GameOverState(winner)
        else:
            game.game_logic.switch_player()
            game.update_status_bar()

class GameOverState(GameState):
    def __init__(self, winner):
        self.winner = winner

    def handle(self, game):
        game.show_game_over(self.winner)
        game.state = self

class Wuziqi:
    def __init__(self, size=15):
        self.size = size
        self.game_logic = GameLogic(size)
        self.root = tk.Tk()
        self.root.title("wuziqi")

        grid_size = 30
        canvas_size = size * grid_size + grid_size * 2
        self.canvas = tk.Canvas(self.root, width=canvas_size, height=canvas_size, bg="lightyellow")
        self.canvas.pack()
        self.canvas.bind("<Button-1>", self.on_click)
        self.draw_board()
        self.setup_input_box()
        
        self.button_frame = tk.Frame(self.root)
        self.button_frame.pack(pady=10)
        
        self.setup_undo_button()
        self.setup_restart_button()
        self.setup_save_load_buttons()
        self.setup_status_bar()
        
        self.history = []
        self.game_state = {}
        self.ui_update_event = threading.Event()
        self.game_logic_thread = None
        self.lock = threading.Lock()
        self.game_logic_queue = queue.Queue()

        self.root.bind('<Return>', lambda event: self.confirm_move())  
        self.root.bind('<Control-c>', lambda event: self.save_game())  
        self.root.bind('<Control-v>', lambda event: self.load_game())  
        self.root.bind('<Command-c>', lambda event: self.save_game())
        self.root.bind('<Command-v>', lambda event: self.load_game())

        self.state = PlayingState()

    def draw_board(self):
        self.canvas.delete("all")
        grid_size = 30
        offset = grid_size
        for i in range(self.size + 1):
            self.canvas.create_line(offset, i * grid_size + offset, (self.size * grid_size) + offset, i * grid_size + offset, width=1, fill="black")
            self.canvas.create_line(i * grid_size + offset, offset, i * grid_size + offset, (self.size * grid_size) + offset, width=1, fill="black")
        
        for i in range(self.size):
            self.canvas.create_text((i * grid_size) + (grid_size // 2) + offset, (self.size * grid_size) + offset + 20, text=chr(ord('A') + i), font=("Arial", 12))
            self.canvas.create_text(20, (self.size - i - 1) * grid_size + (grid_size // 2) + offset, text=str(i + 1), font=("Arial", 12))
        
        stone_radius = 12
        highlight_radius = 1.5
        for i in range(self.size):
            for j in range(self.size):
                if self.game_logic.board[i][j] != '.':
                    x1, y1 = self.calculate_position(i, j)
                    color = "lightblue" if self.game_logic.board[i][j] == 'X' else "pink"
                    self.canvas.create_oval(x1 - stone_radius, y1 - stone_radius, x1 + stone_radius, y1 + stone_radius, fill=color, outline="")
                    if (i, j) == self.game_logic.history[-1] if self.game_logic.history else False:
                        self.canvas.create_oval(x1 - highlight_radius, y1 - highlight_radius, x1 + highlight_radius, y1 + highlight_radius, fill="white", outline="")
                    else:
                        self.canvas.create_oval(x1 - highlight_radius, y1 - highlight_radius, x1 + highlight_radius, y1 + highlight_radius, fill=color, outline="")

        self.root.update_idletasks()

    def calculate_position(self, row, col):
        grid_size = 30
        offset = grid_size
        return (col * grid_size) + (grid_size // 2) + offset, (row * grid_size) + (grid_size // 2) + offset

    def on_click(self, event):
        if event.num == 1:
            self.root.after(50, lambda: self.process_click(event))

    def process_click(self, event):
        grid_size = 30
        offset = grid_size
        col = int((event.x - offset) // grid_size)
        row = int((event.y - offset) // grid_size)
        if self.game_logic.is_valid_move(row, col):
            if self.game_logic.place_stone(row, col):
                self.state.handle(self)
                if self.undo_button:
                    self.undo_button.config(state=tk.NORMAL)
        else:
            messagebox.showinfo("提示", "无效的移动")

    def setup_input_box(self):
        # 创建输入框
        input_frame = tk.Frame(self.root)
        input_frame.pack(pady=10)
        
        tk.Label(input_frame, text="Coordinate (e.g., A1): ", font=("Arial", 12)).pack(side=tk.LEFT)
        self.entry = tk.Entry(input_frame, width=10, font=("Arial", 12))
        self.entry.pack(side=tk.LEFT)
        
        # 创建确认按钮
        confirm_button = tk.Button(input_frame, text="Confirm", command=self.confirm_move, font=("Arial", 12))
        confirm_button.pack(side=tk.LEFT, padx=5)

    def confirm_move(self, event=None):
        move = self.entry.get().strip().upper()
        if len(move) != 2 or move[0] not in 'ABCDEFGHIJKLMNO' or not move[1].isdigit() or int(move[1]) > self.size:
            messagebox.showerror("Error", "Please enter a valid coordinate (e.g., A1)")
            return
        
        col = ord(move[0]) - ord('A')
        row = self.size - int(move[1])  # 反转y轴坐标

        if self.game_logic.place_stone(row, col):
            self.state.handle(self)
        
        self.entry.delete(0, tk.END)  # 清空输入框

    def setup_undo_button(self):
        self.undo_button = tk.Button(self.button_frame, text="Undo", command=self.undo_move, font=("Arial", 12))
        self.undo_button.pack(side=tk.LEFT, padx=5)
        self.undo_button.config(state=tk.DISABLED)  # 游戏开始时禁用Undo按钮

    def undo_move(self):
        if self.game_logic.history:  # 如果有历史记录
            last_move = self.game_logic.history.pop()
            row, col = last_move
            self.game_logic.board[row][col] = '.'
            self.game_logic.switch_player()  # 切换回上一个玩家
            self.draw_board()
            
            # 检查是否还有可以悔棋的步骤
            if not self.game_logic.history:
                self.undo_button.config(state=tk.DISABLED)

    def setup_restart_button(self):
        self.restart_button = tk.Button(self.button_frame, text="Restart", command=self.restart_game, font=("Arial", 12))
        self.restart_button.pack(side=tk.LEFT, padx=5)
        self.restart_button.config(state=tk.DISABLED)  # 游戏开始时禁用重新开始按钮

    def restart_game(self):
        self.game_logic = GameLogic(self.size)  # 重置游戏逻辑
        self.history.clear()
        self.canvas.delete("all")
        self.draw_board()
        self.restart_button.config(state=tk.DISABLED)
        if self.undo_button:
            self.undo_button.config(state=tk.DISABLED)
        self.state = PlayingState()

    def setup_save_load_buttons(self):
        save_button = tk.Button(self.button_frame, text="Save", command=self.save_game, font=("Arial", 12))
        save_button.pack(side=tk.LEFT, padx=5)
        load_button = tk.Button(self.button_frame, text="Load", command=self.load_game, font=("Arial", 12))
        load_button.pack(side=tk.LEFT, padx=5)

    def save_game(self, event=None):
        self.game_state = {
            'board': self.game_logic.board,
            'current_player': self.game_logic.current_player,
            'history': self.game_logic.history
        }
        with open('game_state.json', 'w') as file:
            json.dump(self.game_state, file)
        messagebox.showinfo("wuziqi", "Game saved")

    def load_game(self, event=None):
        try:
            with open('game_state.json', 'r') as file:
                self.game_state = json.load(file)
                self.game_logic.board = self.game_state['board']
                self.game_logic.current_player = self.game_state['current_player']
                self.game_logic.history = self.game_state['history']
                self.draw_board()
                self.update_status_bar()
            messagebox.showinfo("wuziqi", "Game loaded")
        except FileNotFoundError:
            messagebox.showerror("Error", "Saved game file not found")

    def setup_status_bar(self):
        self.status_var = tk.StringVar()
        self.status_bar = tk.Label(self.root, textvariable=self.status_var, bd=1, relief=tk.SUNKEN, anchor=tk.W)
        self.status_bar.pack(side=tk.BOTTOM, fill=tk.X)
        self.update_status_bar()

    def update_status_bar(self):
        self.root.after(0, self.status_var.set, f"Current Player: {self.game_logic.current_player}")

    def show_game_over(self, winner):
        if winner:
            messagebox.showinfo("wuziqi", f"Player {winner} wins!")
        else:
            messagebox.showinfo("wuziqi", "It's a draw!")
        self.restart_button.config(state=tk.NORMAL)  # 游戏结束时启用重新开始按钮

    def start_game_logic_thread(self):
        if self.game_logic_thread is None or not self.game_logic_thread.is_alive():
            self.game_logic_thread = threading.Thread(target=self.game_logic_worker)
            self.game_logic_thread.daemon = True
            self.game_logic_thread.start()

    def game_logic_worker(self):
        while True:
            try:
                self.ui_update_event.wait()
                self.ui_update_event.clear()

                with self.lock:
                    if self.game_logic.history:
                        row, col = self.game_logic.history[-1]
                        self.state.handle(self)
                        
                        self.game_logic_queue.put(lambda: self.update_status_bar())

            except Exception as e:
                print(f"Game logic thread error: {e}")
                if not self.root.winfo_exists():
                    break

    def play(self):
        self.start_game_logic_thread()
        self.root.mainloop()

if __name__ == "__main__":
    game = Wuziqi()
    game.play()
